# Copiar como .env (o ponerlas como "secrets" en Fly.io). NUNCA subir las claves a GitHub.
PUBLIC_HOST=voz-danipro.fly.dev
PROVEEDOR=telnyx
TELNYX_API_KEY=...          # Mission Control > API Keys
TELNYX_PUBLIC_KEY=...       # Mission Control > Keys & Credentials > Public Key (para revisar las firmas)
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
CEREBRO_URL=https://dsxbxbtgtuznlxiyfobu.supabase.co/functions/v1/telefono
SUPABASE_ANON_KEY=...       # la misma clave pública que usa la app (supabase-config.js)
TELEFONO_SECRETO=...        # una clave larga inventada; la misma va en Supabase > Edge Functions > Secrets
# Solo si algún día se usa Twilio (PROVEEDOR=twilio):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
VOZ_URL_CLAVE=...           # clave larga inventada (24+ letras). En Telnyx la Voice URL queda: https://<servidor>/voz?k=ESTA_CLAVE
